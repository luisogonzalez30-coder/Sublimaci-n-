# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa Postgres (Project Settings → Database) para `npm run db:push`
SUPABASE_DB_URL=

# IA
GEMINI_API_KEY=

# Mercado Pago (cuenta de la PLATAFORMA, para cobrar la suscripción del SaaS)
MP_PLATFORM_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Cifrado de tokens de talleres: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# URL pública de la app y soporte
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=
